# Copia este archivo a ".env" y ajusta los valores.

# Puerto del servidor
PORT=3000

# ---------- Base de datos ----------
# Local / pruebas: no definas DATABASE_URL y se usará SQLite (archivo local).
DB_PATH=./futbol7.db
# Producción: define DATABASE_URL con prefijo postgres:// y se usará PostgreSQL automáticamente.
# DATABASE_URL=postgres://usuario:password@host:5432/futbol7
# PGSSL=false   # solo si tu Postgres NO usa SSL (ej. contenedor local)

# ---------- Web Push (VAPID) ----------
# Genera un par de claves con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Cada cuántos ms se revisan los partidos próximos para enviar recordatorios (default 60000 = 1 min)
REMINDER_CHECK_INTERVAL_MS=60000

# ---------- Almacenamiento de fotos / videos ----------
# local (por defecto): guarda en disco, en la carpeta /uploads. Ideal para pruebas locales.
STORAGE_DRIVER=local

# s3: sube a un bucket compatible con S3 (AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.)
# Requiere: npm install @aws-sdk/client-s3
# STORAGE_DRIVER=s3
# S3_BUCKET=mi-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_BASE=https://cdn.midominio.com
# S3_ACL=public-read
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
